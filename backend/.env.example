# Copy to backend/.env (git-ignored) and fill in. Never commit real values.

ENV=dev

# Neon: Dashboard > your project > Connect > copy the connection string (pooled is fine).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/overloader?sslmode=require

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Leave empty in dev: sign-in codes print in the API console instead of being emailed.
RESEND_API_KEY=
SIGNIN_EMAIL_FROM=Overloader <signin@example.com>

# Only needed once the frontend is served from another origin than the API.
CORS_ORIGINS=

# Tests wipe this database. Use a separate Neon branch or database, never the dev one.
TEST_DATABASE_URL=
